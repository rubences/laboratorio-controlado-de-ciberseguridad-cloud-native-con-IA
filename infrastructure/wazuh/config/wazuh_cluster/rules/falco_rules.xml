<!-- Falco / Falcosidekick custom rules -->
<group name="falco,falcosidekick,container,syslog,">

  <rule id="110000" level="3">
    <program_name>^falcosidekick$</program_name>
    <match>"rule":"</match>
    <description>Falco event received via Falcosidekick JSON syslog</description>
    <group>falco,falcosidekick,container_runtime,</group>
  </rule>

  <rule id="110001" level="8">
    <if_sid>110000</if_sid>
    <match>"priority":"Warning"</match>
    <description>Falco warning event forwarded to Wazuh</description>
    <group>falco_warning,</group>
  </rule>

  <rule id="110003" level="10">
    <if_sid>110001</if_sid>
    <match>/etc/shadow</match>
    <description>Falco detected untrusted access to /etc/shadow</description>
    <group>falco_sensitive_file,mitre_T1555,credential_access,</group>
  </rule>

</group>
