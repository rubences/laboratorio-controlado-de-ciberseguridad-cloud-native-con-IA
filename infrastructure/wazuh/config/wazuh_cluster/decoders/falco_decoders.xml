<!-- Falco / Falcosidekick custom decoders -->
<decoder name="falcosidekick-syslog">
  <type>syslog</type>
  <program_name>^falcosidekick$</program_name>
</decoder>

<decoder name="falcosidekick-fields">
  <parent>falcosidekick-syslog</parent>
  <regex type="pcre2">"priority":"([^"]+)".*"rule":"([^"]+)".*"source":"([^"]+)".*"time":"([^"]+)"</regex>
  <order>priority,rule,source,falco_time</order>
</decoder>
